# ── Supabase ─────────────────────────────────────────────────────────────────
# Found at: https://supabase.com/dashboard → your project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://houspire-social-portal.vercel.app

# ── Cron ─────────────────────────────────────────────────────────────────────
# Set this in Vercel env vars. Vercel injects it as Authorization: Bearer <CRON_SECRET>
# when triggering cron jobs. Never commit the actual value.
CRON_SECRET=your-random-secret-here
# Email address to receive alerts when cron jobs fail
CRON_ALERT_EMAIL=admin@houspire.ai

# ── AI — Claude / Anthropic ──────────────────────────────────────────────────
# Get at: https://console.anthropic.com/account/keys
ANTHROPIC_API_KEY=sk-ant-...

# ── Email — Resend ────────────────────────────────────────────────────────────
# Get at: https://resend.com/api-keys
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=Houspire <notifications@houspire.ai>

# ── Instagram Graph API ───────────────────────────────────────────────────────
# Long-lived page access token (valid 60 days, auto-refreshed by token-refresh cron)
# Get via: https://developers.facebook.com/tools/explorer/
# Requires: instagram_content_publish permission
INSTAGRAM_ACCESS_TOKEN=your-ig-long-lived-token
INSTAGRAM_USER_ID=your-ig-business-account-id
# ISO date when the token was issued — used for expiry warnings
INSTAGRAM_TOKEN_ISSUED_AT=2026-03-17T00:00:00.000Z

# ── LinkedIn UGC Posts API ────────────────────────────────────────────────────
# OAuth 2.0 access token (valid 60 days — requires manual re-auth to refresh)
# Get via: https://www.linkedin.com/developers/tools/oauth
# Requires: w_organization_social permission
LINKEDIN_ACCESS_TOKEN=your-li-access-token
LINKEDIN_ORGANIZATION_ID=your-li-org-id
# ISO date when the token was issued — used for 10-day expiry warning emails
LINKEDIN_TOKEN_ISSUED_AT=2026-03-17T00:00:00.000Z
